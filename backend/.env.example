NODE_ENV=development
PORT=3333

# PostgreSQL — corre con: docker compose up -d
DATABASE_URL="postgresql://freelance_hub:freelance_hub_dev_password@localhost:5433/freelance_hub?schema=public"

# JWT — genera secretos fuertes con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET="reemplaza-esto-con-un-secreto-de-al-menos-32-caracteres"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="reemplaza-esto-con-otro-secreto-distinto-de-32-caracteres"
JWT_REFRESH_EXPIRATION="7d"

# Stripe — desde tu dashboard de Stripe (modo test)
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"
STRIPE_PRICE_ID_PRO="price_xxxxxxxxxxxx"
STRIPE_PRICE_ID_BUSINESS="price_xxxxxxxxxxxx"

# Resend — para emails transaccionales (verificación, reset de password)
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="Freelance Hub <onboarding@resend.dev>"

FRONTEND_URL="http://localhost:3000"

THROTTLE_TTL=60
THROTTLE_LIMIT=100