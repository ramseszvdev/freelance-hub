# URL de tu backend NestJS. SIN prefijo NEXT_PUBLIC_ a propósito:
# esta variable solo la usa el servidor de Next.js (Route Handlers),
# nunca se expone al navegador. El navegador nunca habla directo
# con NestJS, siempre pasa por las rutas /api/* de este proyecto.
BACKEND_API_URL="http://localhost:3333/api/v1"